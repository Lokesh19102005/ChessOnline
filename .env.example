# ============================================
# Server Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas connection string for production)
MONGODB_URI=mongodb://localhost:27017/chessmate

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Metered TURN Server (comma-separated list of URLs)
TURN_URL=turn:your-turn-server.metered.live:443
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# Client URL for CORS (your deployed frontend URL)
# For production: https://your-app.vercel.app
# For multiple origins: https://your-app.vercel.app,https://custom-domain.com
CLIENT_URL=http://localhost:5173

# ============================================
# Client Environment Variables (VITE_ prefix)
# These go in client/.env or client/.env.production
# ============================================
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
