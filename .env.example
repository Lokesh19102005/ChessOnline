# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chessmate

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Metered TURN Server (can be a comma-separated list of URLs)
TURN_URL=turn:your-turn-server.metered.live:443
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
